import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct ChatMessage {
    author: string,
    content: string,
    outgoing: bool,
}

export struct AdminNotification {
    title: string,
    content: string,
    status: string,
}

export component MainWindow inherits Window {
    in property <string> app-title;
    in property <string> nav-chat;
    in property <string> nav-devices;
    in property <string> nav-games;
    in property <string> nav-alerts;
    in property <string> nav-settings;
    in property <string> search-chats;
    in property <string> lan-channel;
    in property <string> channel-broadcast;
    in property <string> input-message;
    in property <string> send-label;
    in property <string> input-hint;
    in property <int> page;
    in property <string> page-title;
    title: root.app-title;
    width: 1180px;
    height: 760px;
    background: #f4f7f9;
    in property <[ChatMessage]> messages;
    in property <[AdminNotification]> notifications;
    callback select-page(int);

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 72px;
            background: #103f3d;
            VerticalLayout {
                padding-top: 18px;
                spacing: 14px;
                Text { text: "L"; color: white; font-size: 24px; horizontal-alignment: center; }
                Button { text: root.nav-chat; clicked => { root.select-page(0); } }
                Button { text: root.nav-devices; clicked => { root.select-page(1); } }
                Button { text: root.nav-games; clicked => { root.select-page(2); } }
                Button { text: root.nav-alerts; clicked => { root.select-page(3); } }
                Button { text: root.nav-settings; clicked => { root.select-page(4); } }
            }
        }

        Rectangle {
            width: 270px;
            background: #f9fbfc;
            border-width: 1px;
            border-color: #e1e8ed;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout { Text { text: root.nav-chat; font-size: 20px; font-weight: 700; } Text { text: "+"; horizontal-alignment: right; font-size: 22px; } }
                LineEdit { placeholder-text: root.search-chats; }
                Rectangle { height: 64px; border-radius: 7px; background: #e2f5f1; VerticalLayout { padding: 10px; Text { text: root.lan-channel; font-size: 16px; } Text { text: root.channel-broadcast; color: #6d8790; } } }
                Rectangle { height: 64px; border-radius: 7px; VerticalLayout { padding: 10px; Text { text: "最近联系人"; font-size: 16px; } Text { text: "原生界面迁移中"; color: #8798a4; } } }
            }
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            Rectangle { height: 78px; background: white; border-width: 1px; border-color: #e1e8ed; VerticalLayout { padding-left: 24px; padding-top: 15px; Text { text: root.page-title; font-size: 20px; font-weight: 700; } Text { text: root.page == 3 ? "本机已收到的管理员公告" : root.channel-broadcast; color: #718693; } } }
            if root.page == 3 : Rectangle {
                vertical-stretch: 1;
                background: white;
                ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        for notification in root.notifications: Rectangle {
                            min-height: 86px;
                            border-radius: 8px;
                            background: #f2f7f7;
                            border-width: 1px;
                            border-color: #dce8e7;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 5px;
                                Text { text: notification.title; color: #163d3a; font-size: 16px; font-weight: 700; }
                                Text { text: notification.content; color: #536c70; wrap: word-wrap; }
                                Text { text: notification.status; color: #879a9d; font-size: 12px; }
                            }
                        }
                    }
                }
            }
            if root.page != 3 : Rectangle {
                vertical-stretch: 1;
                background: white;
                ScrollView {
                    VerticalLayout {
                        width: root.width - 342px;
                        padding: 22px;
                        spacing: 12px;
                        for message in root.messages: HorizontalLayout {
                            Rectangle {
                                width: 360px;
                                min-height: 46px;
                                border-radius: 8px;
                                background: message.outgoing ? #159e90 : #eef3f5;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    Text { text: message.author; color: message.outgoing ? #d9fbf5 : #647984; font-size: 12px; }
                                    Text { text: message.content; color: message.outgoing ? white : #18313d; wrap: word-wrap; font-size: 15px; }
                                }
                            }
                        }
                    }
                }
            }
            if root.page == 0 : Rectangle { height: 142px; background: #fafcfd; border-width: 1px; border-color: #e1e8ed; VerticalLayout { padding: 14px; spacing: 10px; Text { text: "☺   📎   🎙   @"; color: #607583; font-size: 18px; } LineEdit { placeholder-text: root.input-message; } HorizontalLayout { Text { text: root.input-hint; color: #9aa9b5; } Button { text: root.send-label; horizontal-stretch: 0; } } } }
        }
    }
}
