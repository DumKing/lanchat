import { Button, LineEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "LanChat 原生版";
    width: 1180px;
    height: 760px;
    background: #f4f7f9;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 72px;
            background: #103f3d;
            VerticalLayout {
                padding-top: 18px;
                spacing: 14px;
                Text { text: "L"; color: white; font-size: 24px; horizontal-alignment: center; }
                Rectangle { height: 42px; border-radius: 8px; background: #159e90; Text { text: "聊"; color: white; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } }
                Text { text: "设"; color: #b9d8d4; font-size: 18px; horizontal-alignment: center; }
                Text { text: "游"; color: #b9d8d4; font-size: 18px; horizontal-alignment: center; }
                Text { text: "狼"; color: #b9d8d4; font-size: 18px; horizontal-alignment: center; }
            }
        }

        Rectangle {
            width: 270px;
            background: #f9fbfc;
            border-width: 1px;
            border-color: #e1e8ed;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout { Text { text: "聊天"; font-size: 20px; font-weight: 700; } Text { text: "+"; horizontal-alignment: right; font-size: 22px; } }
                LineEdit { placeholder-text: "搜索聊天"; }
                Rectangle { height: 64px; border-radius: 7px; background: #e2f5f1; VerticalLayout { padding: 10px; Text { text: "局域网频道"; font-size: 16px; } Text { text: "频道广播"; color: #6d8790; } } }
                Rectangle { height: 64px; border-radius: 7px; VerticalLayout { padding: 10px; Text { text: "最近联系人"; font-size: 16px; } Text { text: "原生界面迁移中"; color: #8798a4; } } }
            }
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            Rectangle { height: 78px; background: white; border-width: 1px; border-color: #e1e8ed; VerticalLayout { padding-left: 24px; padding-top: 15px; Text { text: "局域网频道"; font-size: 20px; font-weight: 700; } Text { text: "原生 Slint 主窗口"; color: #718693; } } }
            Rectangle { vertical-stretch: 1; background: white; Text { text: "欢迎来到 LanChat 原生版\n聊天、设备、设置与游戏将分阶段迁移。"; color: #718693; horizontal-alignment: center; vertical-alignment: center; font-size: 17px; } }
            Rectangle { height: 142px; background: #fafcfd; border-width: 1px; border-color: #e1e8ed; VerticalLayout { padding: 14px; spacing: 10px; Text { text: "☺   📎   🎙   @"; color: #607583; font-size: 18px; } LineEdit { placeholder-text: "输入消息"; } HorizontalLayout { Text { text: "Enter 发送 · Shift+Enter 换行"; color: #9aa9b5; } Button { text: "发送"; horizontal-stretch: 0; } } } }
        }
