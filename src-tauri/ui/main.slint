import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct ChatMessage { author: string, content: string, outgoing: bool }
export struct AdminNotification { title: string, content: string, status: string }
export struct Conversation { id: string, title: string, subtitle: string, unread-count: string }
export struct Device { id: string, nickname: string, address: string, status: string, capability: string }
export struct DeviceDetail { nickname: string, device-id: string, address: string, status: string, capability: string, client-kind: string, build-version: string }
export struct PetOption { id: string, name: string, selected: bool }
export struct ChannelMember { nickname: string, detail: string, online: bool }
export struct AlertItem { id: string, sender-device-id: string, sender: string, source: string, content: string, feedback-allowed: bool }
export struct GameOption { id: string, name: string, description: string, icon: string, players: string }
export struct GameRoom { id: string, game-id: string, game-name: string, name: string, host: string, players: string }

component RailAction inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: 48px; height: 48px; border-radius: 10px;
    background: active ? #159b8c : transparent;
    VerticalLayout { padding: 5px; spacing: 0px;
        Text { text: icon; color: active ? white : #b9d8d2; font-size: 18px; horizontal-alignment: center; }
        Text { text: label; color: active ? white : #b9d8d2; font-size: 10px; horizontal-alignment: center; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

component InitialAvatar inherits Rectangle {
    in property <string> value;
    in property <color> fill: #d9f1ec;
    width: 38px; height: 38px; border-radius: 10px; background: fill;
    Text { text: value; color: #147d70; font-size: 15px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
}

export component MainWindow inherits Window {
    in property <string> app-title;
    in property <string> nav-chat;
    in property <string> nav-devices;
    in property <string> nav-games;
    in property <string> nav-alerts;
    in property <string> nav-settings;
    in property <string> search-chats;
    in property <string> lan-channel;
    in property <string> channel-broadcast;
    in property <string> input-message;
    in property <string> send-label;
    in property <string> input-hint;
    in-out property <string> message-input;
    in property <string> send-feedback;
    in-out property <string> active-conversation-id: "lan-room";
    in property <bool> active-conversation-is-group: true;
    in property <int> page;
    in property <string> page-title;
    in property <[ChatMessage]> messages;
    in property <[AdminNotification]> notifications;
    in property <[Conversation]> conversations;
    in property <[Device]> peers;
    in property <DeviceDetail> selected-device;
    in property <[PetOption]> pets;
    in property <[ChannelMember]> channel-members;
    in property <[AlertItem]> alerts;
    in property <[GameOption]> games;
    in property <[GameRoom]> game-rooms;
    in property <bool> pet-enabled;
    in property <string> current-locale;
    in-out property <string> profile-nickname;
    in property <string> settings-feedback;
    callback select-page(int); callback select-conversation(string); callback select-device(string);
    callback save-profile(string); callback select-pet(string); callback toggle-pet(bool);
    callback send-message(string); callback send-alert(); callback feedback-alert(string, string, string);
    callback create-game-room(string); callback join-game-room(string, string);
    callback set-locale(string);
    title: root.app-title; min-width: 1000px; min-height: 620px; background: #f3f8f6;

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 72px; background: #102f2d;
            VerticalLayout { padding-top: 14px; padding-bottom: 13px; spacing: 9px;
                InitialAvatar { width: 44px; height: 44px; fill: #17635d; value: "L"; }
                Rectangle { height: 6px; background: transparent; }
                RailAction { icon: "●"; label: root.nav-chat; active: root.page == 0; clicked => { root.select-page(0); } }
                RailAction { icon: "▣"; label: root.nav-devices; active: root.page == 1; clicked => { root.select-page(1); } }
                RailAction { icon: "♟"; label: root.nav-games; active: root.page == 2; clicked => { root.select-page(2); } }
                RailAction { icon: "!"; label: root.nav-alerts; active: root.page == 3; clicked => { root.select-page(3); } }
                RailAction { icon: "＋"; label: "新建"; active: false; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                RailAction { icon: "⚙"; label: root.nav-settings; active: root.page == 4; clicked => { root.select-page(4); } }
            }
        }

        Rectangle {
            width: 292px; background: #f5faf8; border-width: 1px; border-color: #d9e5e1;
            VerticalLayout { padding-top: 17px; spacing: 10px;
                HorizontalLayout { padding-left: 17px; padding-right: 15px;
                    Text { text: root.nav-chat; color: #1b3532; font-size: 20px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: "＋"; color: #2d625b; font-size: 21px; }
                    Text { text: "↻"; color: #55736e; font-size: 18px; }
                }
                HorizontalLayout { padding-left: 15px; padding-right: 15px;
                    Rectangle { height: 36px; border-radius: 8px; border-width: 1px; border-color: #d5e3df; background: white;
                        LineEdit { text: ""; placeholder-text: root.search-chats; }
                    }
                }
                Rectangle { height: 1px; background: #dfe9e6; }
                HorizontalLayout { padding-left: 9px; padding-right: 9px;
                    Rectangle { height: 70px; border-width: 1px; border-color: #159b8c; border-radius: 8px; background: #e2f5f0;
                        HorizontalLayout { padding: 10px; spacing: 10px;
                            InitialAvatar { value: "局"; fill: #d3f0e9; }
                            VerticalLayout { spacing: 3px;
                                Text { text: root.lan-channel; color: #1d4540; font-size: 15px; font-weight: 700; }
                                Text { text: root.channel-broadcast; color: #6f8984; font-size: 12px; }
                            }
                        }
                        TouchArea { clicked => { root.active-conversation-id = "lan-room"; root.select-conversation("lan-room"); } }
                    }
                }
                ScrollView { vertical-stretch: 1;
                    VerticalLayout { padding-left: 9px; padding-right: 9px; spacing: 4px;
                        for conversation in root.conversations: Rectangle {
                            height: 67px; border-radius: 8px; background: conversation.id == root.active-conversation-id ? #e7f5f1 : transparent;
                            HorizontalLayout { padding: 10px; spacing: 10px;
                                InitialAvatar { value: conversation.title == "" ? "L" : conversation.title; }
                                VerticalLayout { spacing: 4px;
                                    HorizontalLayout { Text { text: conversation.title; color: #243b38; font-size: 14px; font-weight: 700; } Text { text: conversation.unread-count; color: #ec5361; horizontal-alignment: right; font-size: 12px; } }
                                    Text { text: conversation.subtitle; color: #819692; font-size: 12px; }
                                }
                            }
                            TouchArea { clicked => { root.active-conversation-id = conversation.id; root.select-conversation(conversation.id); } }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            padding: 0px; spacing: 0px;
            Rectangle { height: 76px; background: #fbfdfc; border-width: 1px; border-color: #dfe9e6;
                VerticalLayout { padding-left: 24px; padding-top: 14px; spacing: 3px;
                    Text { text: root.page-title; color: #1d3834; font-size: 19px; font-weight: 700; }
                    Text { text: root.page == 3 ? "告警处理与本机历史通知" : root.channel-broadcast; color: #77908b; font-size: 12px; }
                }
            }
            if root.page == 0 : Rectangle { vertical-stretch: 1; background: #ffffff;
                ScrollView { vertical-stretch: 1;
                    VerticalLayout { padding-left: 28px; padding-right: 28px; padding-top: 20px; padding-bottom: 18px; spacing: 13px;
                        Text { text: "今天"; color: #8da19d; font-size: 11px; horizontal-alignment: center; }
                        for message in root.messages: HorizontalLayout {
                            Rectangle { horizontal-stretch: message.outgoing ? 1 : 0; background: transparent; }
                            InitialAvatar { value: message.author; fill: message.outgoing ? #1a9b8d : #d9f1ec; }
                            Rectangle { max-width: 440px; min-height: 46px; border-radius: 8px; border-width: message.outgoing ? 0 : 1px; border-color: #dfe9e6; background: message.outgoing ? #159b8c : #f5f8f7;
                                VerticalLayout { padding: 10px; spacing: 3px;
                                    Text { text: message.author; color: message.outgoing ? #d5f7f0 : #748b86; font-size: 11px; horizontal-alignment: message.outgoing ? right : left; }
                                    Text { text: message.content; color: message.outgoing ? white : #263e3a; wrap: word-wrap; font-size: 14px; }
                                }
                            }
                            if message.outgoing : InitialAvatar { value: "我"; fill: #159b8c; }
                            Rectangle { horizontal-stretch: message.outgoing ? 0 : 1; background: transparent; }
                        }
                    }
                }
            }
            if root.page == 1 : Rectangle { vertical-stretch: 1; background: white;
                ScrollView { VerticalLayout { padding: 20px; spacing: 7px;
                    Text { text: "已发现设备"; color: #627c76; font-size: 13px; }
                    for peer in root.peers: Rectangle { height: 62px; border-radius: 8px; border-width: 1px; border-color: #dfe9e6; background: #fbfdfc;
                        HorizontalLayout { padding: 11px; spacing: 11px;
                            InitialAvatar { value: peer.nickname; }
                            VerticalLayout { spacing: 3px; Text { text: peer.nickname; color: #243b38; font-size: 14px; font-weight: 700; } Text { text: peer.address + " · " + peer.capability; color: #819692; font-size: 12px; } }
                            Text { text: peer.status; color: peer.status == "在线" ? #18a766 : #e2575e; font-size: 12px; horizontal-alignment: right; }
                        }
                        TouchArea { clicked => { root.select-device(peer.id); } }
                    }
                } }
            }
            if root.page == 2 : Rectangle { vertical-stretch: 1; background: white;
                ScrollView { VerticalLayout { padding: 22px; spacing: 10px;
                    Text { text: "局域网游戏"; color: #203e39; font-size: 18px; font-weight: 700; }
                    Text { text: "创建房间后向当前在线设备广播。"; color: #78908b; font-size: 12px; }
                    for game in root.games: Rectangle { min-height: 76px; border-radius: 8px; border-width: 1px; border-color: #dbe8e5; background: #f7fbfa;
                        HorizontalLayout { padding: 12px; spacing: 12px;
                            InitialAvatar { value: game.icon; fill: #d8f1ec; }
                            VerticalLayout { spacing: 3px; Text { text: game.name + " · " + game.players; color: #1e4640; font-size: 15px; font-weight: 700; } Text { text: game.description; color: #748d87; font-size: 12px; wrap: word-wrap; } }
                            Button { text: "创建房间"; horizontal-stretch: 0; clicked => { root.create-game-room(game.id); } }
                        }
                    }
                    Text { text: "已发现房间"; color: #203e39; font-size: 16px; font-weight: 700; }
                    for room in root.game-rooms: Rectangle { min-height: 58px; border-radius: 8px; border-width: 1px; border-color: #dbe8e5; background: white;
                        HorizontalLayout { padding: 10px; spacing: 10px; VerticalLayout { spacing: 3px; Text { text: room.name + " · " + room.game-name; font-size: 14px; font-weight: 700; } Text { text: "房主：" + room.host + " · " + room.players; color: #758e88; font-size: 12px; } } Button { text: "加入"; horizontal-stretch: 0; clicked => { root.join-game-room(room.id, room.game-id); } } }
                    }
                } }
            }
            if root.page == 3 : Rectangle { vertical-stretch: 1; background: white;
                ScrollView { VerticalLayout { padding: 22px; spacing: 10px;
                    HorizontalLayout { Text { text: "最近告警"; color: #203e39; font-size: 18px; font-weight: 700; } Button { text: "发送告警"; horizontal-stretch: 0; clicked => { root.send-alert(); } } }
                    for alert in root.alerts: Rectangle { min-height: 78px; border-radius: 8px; border-width: 1px; border-color: #f1d9d2; background: #fff7f4;
                        VerticalLayout { padding: 11px; spacing: 4px; Text { text: alert.sender + " · " + alert.source; color: #926158; font-size: 12px; } Text { text: alert.content; color: #442d29; font-size: 14px; font-weight: 700; wrap: word-wrap; } if alert.feedback-allowed : HorizontalLayout { Button { text: "真实"; clicked => { root.feedback-alert(alert.id, alert.sender-device-id, "real"); } } Button { text: "虚假"; clicked => { root.feedback-alert(alert.id, alert.sender-device-id, "false"); } } } }
                    }
                    Text { text: "历史公告通知"; color: #203e39; font-size: 16px; font-weight: 700; }
                    for notification in root.notifications: Rectangle { min-height: 74px; border-radius: 8px; border-width: 1px; border-color: #dce8e5; background: #f7fbfa;
                        VerticalLayout { padding: 11px; spacing: 4px; Text { text: notification.title; color: #1f4942; font-size: 14px; font-weight: 700; } Text { text: notification.content; color: #617872; font-size: 12px; wrap: word-wrap; } Text { text: notification.status; color: #8a9c98; font-size: 11px; } }
                    }
                } }
            }
            if root.page == 4 : Rectangle { vertical-stretch: 1; background: white;
                ScrollView { VerticalLayout { padding: 26px; spacing: 12px;
                    Text { text: "基础设置"; color: #203e39; font-size: 18px; font-weight: 700; } Text { text: "本机资料"; color: #708984; font-size: 12px; }
                    LineEdit { text <=> root.profile-nickname; placeholder-text: "输入昵称"; } Button { text: "保存昵称"; horizontal-stretch: 0; clicked => { root.save-profile(root.profile-nickname); } } Text { text: root.settings-feedback; color: #159b8c; font-size: 12px; }
                    Rectangle { height: 1px; background: #e1ebe8; } Text { text: "桌宠设置"; color: #203e39; font-size: 18px; font-weight: 700; } Button { text: root.pet-enabled ? "关闭桌宠" : "开启桌宠"; horizontal-stretch: 0; clicked => { root.toggle-pet(!root.pet-enabled); } } Text { text: "已导入桌宠"; color: #708984; font-size: 12px; }
                    for pet in root.pets: Button { text: pet.selected ? ("✓  " + pet.name) : pet.name; clicked => { root.select-pet(pet.id); } }
                    Rectangle { height: 1px; background: #e1ebe8; } Text { text: "语言"; color: #203e39; font-size: 18px; font-weight: 700; } HorizontalLayout { spacing: 8px; Button { text: root.current-locale == "zh-CN" ? "✓ 中文" : "中文"; horizontal-stretch: 0; clicked => { root.set-locale("zh-CN"); } } Button { text: root.current-locale == "en-US" ? "✓ English" : "English"; horizontal-stretch: 0; clicked => { root.set-locale("en-US"); } } }
                } }
            }
            if root.page == 0 : Rectangle { height: 148px; border-width: 1px; border-color: #dfe9e6; background: #fbfdfc;
                VerticalLayout { padding: 13px; spacing: 9px; Text { text: "☺   ◉   ▣   ♫   @"; color: #54716b; font-size: 18px; }
                    Rectangle { vertical-stretch: 1; border-radius: 8px; border-width: 1px; border-color: #d7e4e0; background: white; VerticalLayout { padding: 9px; LineEdit { text <=> root.message-input; placeholder-text: root.input-message; } HorizontalLayout { Text { text: root.send-feedback == "" ? root.input-hint : root.send-feedback; color: #8a9d98; font-size: 11px; } Button { text: root.send-label; horizontal-stretch: 0; clicked => { root.send-message(root.message-input); } } } } }
                }
            }
        }

        if root.page == 0 && root.active-conversation-is-group : Rectangle { width: 238px; background: #f8fbfa; border-width: 1px; border-color: #d9e5e1;
            VerticalLayout { padding-top: 18px; spacing: 8px; HorizontalLayout { padding-left: 16px; Text { text: "频道信息"; color: #24453f; font-size: 16px; font-weight: 700; } } HorizontalLayout { padding-left: 14px; padding-right: 14px; Rectangle { min-height: 62px; border-radius: 8px; border-width: 1px; border-color: #dce8e5; background: white; VerticalLayout { padding: 9px; Text { text: "频道公告"; color: #42645e; font-size: 12px; font-weight: 700; } Text { text: "局域网内的即时交流频道"; color: #819692; font-size: 11px; } } } } Rectangle { height: 1px; background: #dfe9e6; } HorizontalLayout { padding-left: 16px; Text { text: "频道成员"; color: #24453f; font-size: 15px; font-weight: 700; } } ScrollView { vertical-stretch: 1; VerticalLayout { padding-left: 14px; padding-right: 14px; spacing: 2px; for member in root.channel-members: HorizontalLayout { height: 34px; InitialAvatar { width: 27px; height: 27px; border-radius: 8px; value: member.nickname; } Text { text: member.nickname; color: #385650; font-size: 12px; } Text { text: member.detail; color: member.online ? #20a76b : #da6066; font-size: 10px; horizontal-alignment: right; } } } } }
        }
        if root.page == 1 : Rectangle { width: 248px; background: #f8fbfa; border-width: 1px; border-color: #d9e5e1; VerticalLayout { padding: 18px; spacing: 8px; Text { text: "设备详情"; color: #24453f; font-size: 17px; font-weight: 700; } Text { text: root.selected-device.nickname; color: #24453f; font-size: 16px; font-weight: 700; } Rectangle { height: 1px; background: #dfe9e6; } Text { text: "MAC"; color: #849993; font-size: 11px; } Text { text: root.selected-device.device-id; color: #3e5d57; font-size: 12px; wrap: word-wrap; } Text { text: "地址"; color: #849993; font-size: 11px; } Text { text: root.selected-device.address; color: #3e5d57; font-size: 12px; wrap: word-wrap; } Text { text: root.selected-device.status + " · " + root.selected-device.capability; color: #159b8c; font-size: 12px; } Text { text: root.selected-device.client-kind + " · " + root.selected-device.build-version; color: #849993; font-size: 11px; wrap: word-wrap; } } }
    }
}
