import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct ChatMessage {
    author: string,
    content: string,
    outgoing: bool,
}

export struct AdminNotification {
    title: string,
    content: string,
    status: string,
}

export struct Conversation {
    id: string,
    title: string,
    subtitle: string,
    unread-count: string,
}

export struct Device {
    nickname: string,
    address: string,
    status: string,
    capability: string,
}

export struct PetOption {
    id: string,
    name: string,
    selected: bool,
}

export component MainWindow inherits Window {
    in property <string> app-title;
    in property <string> nav-chat;
    in property <string> nav-devices;
    in property <string> nav-games;
    in property <string> nav-alerts;
    in property <string> nav-settings;
    in property <string> search-chats;
    in property <string> lan-channel;
    in property <string> channel-broadcast;
    in property <string> input-message;
    in property <string> send-label;
    in property <string> input-hint;
    in-out property <string> message-input;
    in property <string> send-feedback;
    in property <int> page;
    in property <string> page-title;
    title: root.app-title;
    width: 1180px;
    height: 760px;
    background: #f4f7f9;
    in property <[ChatMessage]> messages;
    in property <[AdminNotification]> notifications;
    in property <[Conversation]> conversations;
    in property <[Device]> peers;
    in property <[PetOption]> pets;
    in property <bool> pet-enabled;
    in-out property <string> profile-nickname;
    in property <string> settings-feedback;
    callback select-page(int);
    callback select-conversation(string);
    callback save-profile(string);
    callback select-pet(string);
    callback toggle-pet(bool);
    callback send-message(string);

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 72px;
            background: #103f3d;
            VerticalLayout {
                padding-top: 18px;
                spacing: 14px;
                Text { text: "L"; color: white; font-size: 24px; horizontal-alignment: center; }
                Button { text: root.nav-chat; clicked => { root.select-page(0); } }
                Button { text: root.nav-devices; clicked => { root.select-page(1); } }
                Button { text: root.nav-games; clicked => { root.select-page(2); } }
                Button { text: root.nav-alerts; clicked => { root.select-page(3); } }
                Button { text: root.nav-settings; clicked => { root.select-page(4); } }
            }
        }

        Rectangle {
            width: 270px;
            background: #f9fbfc;
            border-width: 1px;
            border-color: #e1e8ed;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout { Text { text: root.nav-chat; font-size: 20px; font-weight: 700; } Text { text: "+"; horizontal-alignment: right; font-size: 22px; } }
                LineEdit { placeholder-text: root.search-chats; }
                Rectangle { height: 64px; border-radius: 7px; background: #e2f5f1; VerticalLayout { padding: 10px; Text { text: root.lan-channel; font-size: 16px; } Text { text: root.channel-broadcast; color: #6d8790; } } TouchArea { clicked => { root.select-conversation("lan-room"); } } }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for conversation in root.conversations: Rectangle {
                            height: 62px;
                            border-radius: 7px;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 9px;
                                spacing: 3px;
                                HorizontalLayout {
                                    Text { text: conversation.title; font-size: 15px; font-weight: 600; }
                                    Text { text: conversation.unread-count; color: #e84d59; horizontal-alignment: right; }
                                }
                                Text { text: conversation.subtitle; color: #8798a4; font-size: 12px; }
                            }
                            TouchArea { clicked => { root.select-conversation(conversation.id); } }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            Rectangle { height: 78px; background: white; border-width: 1px; border-color: #e1e8ed; VerticalLayout { padding-left: 24px; padding-top: 15px; Text { text: root.page-title; font-size: 20px; font-weight: 700; } Text { text: root.page == 3 ? "本机已收到的管理员公告" : root.channel-broadcast; color: #718693; } } }
            if root.page == 3 : Rectangle {
                vertical-stretch: 1;
                background: white;
                ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        for notification in root.notifications: Rectangle {
                            min-height: 86px;
                            border-radius: 8px;
                            background: #f2f7f7;
                            border-width: 1px;
                            border-color: #dce8e7;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 5px;
                                Text { text: notification.title; color: #163d3a; font-size: 16px; font-weight: 700; }
                                Text { text: notification.content; color: #536c70; wrap: word-wrap; }
                                Text { text: notification.status; color: #879a9d; font-size: 12px; }
                            }
                        }
                    }
                }
            }
            if root.page == 0 : Rectangle {
                vertical-stretch: 1;
                background: white;
                ScrollView {
                    VerticalLayout {
                        width: root.width - 342px;
                        padding: 22px;
                        spacing: 12px;
                        for message in root.messages: HorizontalLayout {
                            Rectangle {
                                width: 360px;
                                min-height: 46px;
                                border-radius: 8px;
                                background: message.outgoing ? #159e90 : #eef3f5;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    Text { text: message.author; color: message.outgoing ? #d9fbf5 : #647984; font-size: 12px; }
                                    Text { text: message.content; color: message.outgoing ? white : #18313d; wrap: word-wrap; font-size: 15px; }
                                }
                            }
                        }
                    }
                }
            }
            if root.page == 1 : Rectangle {
                vertical-stretch: 1;
                background: white;
                ScrollView {
                    VerticalLayout {
                        padding: 24px;
                        spacing: 10px;
                        for peer in root.peers: Rectangle {
                            height: 64px;
                            border-radius: 7px;
                            background: #f7fafb;
                            border-width: 1px;
                            border-color: #e1e8ed;
                            HorizontalLayout {
                                padding: 12px;
                                spacing: 12px;
                                Rectangle { width: 38px; height: 38px; border-radius: 19px; background: #d8f1ed; Text { text: "●"; color: #108c81; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; } }
                                VerticalLayout { spacing: 3px; Text { text: peer.nickname; font-size: 16px; font-weight: 600; } Text { text: peer.address; color: #82949f; font-size: 12px; } }
                                VerticalLayout { horizontal-stretch: 0; spacing: 3px; Text { text: peer.status; color: peer.status == "在线" ? #16a765 : #d8565f; horizontal-alignment: right; } Text { text: peer.capability; color: #82949f; font-size: 12px; horizontal-alignment: right; } }
                            }
                        }
                    }
                }
            }
            if root.page == 4 : Rectangle {
                vertical-stretch: 1;
                background: white;
                VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    Text { text: "基础设置"; font-size: 18px; font-weight: 700; color: #173f3d; }
                    Text { text: "本机资料"; color: #5b7377; font-size: 14px; }
                    LineEdit { text <=> root.profile-nickname; placeholder-text: "输入昵称"; }
                    Button { text: "保存昵称"; clicked => { root.save-profile(root.profile-nickname); } }
                    Text { text: root.settings-feedback; color: #159e90; font-size: 13px; }
                    Rectangle { height: 1px; background: #e5edef; }
                    Text { text: "桌宠设置"; font-size: 18px; font-weight: 700; color: #173f3d; }
                    Button { text: root.pet-enabled ? "关闭桌宠" : "开启桌宠"; clicked => { root.toggle-pet(!root.pet-enabled); } }
                    Text { text: "已导入桌宠"; color: #5b7377; font-size: 14px; }
                    for pet in root.pets: Button { text: pet.selected ? ("✓  " + pet.name) : pet.name; clicked => { root.select-pet(pet.id); } }
                }
            }
            if root.page == 0 : Rectangle { height: 142px; background: #fafcfd; border-width: 1px; border-color: #e1e8ed; VerticalLayout { padding: 14px; spacing: 10px; Text { text: "☺   📎   🎙   @"; color: #607583; font-size: 18px; } LineEdit { text <=> root.message-input; placeholder-text: root.input-message; } HorizontalLayout { Text { text: root.send-feedback == "" ? root.input-hint : root.send-feedback; color: #159e90; } Button { text: root.send-label; horizontal-stretch: 0; clicked => { root.send-message(root.message-input); } } } } }
        }
    }
}
