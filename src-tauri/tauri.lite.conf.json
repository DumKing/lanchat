{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lanchat-lite",
  "mainBinaryName": "lanchat-lite",
  "version": "0.3.0",
  "identifier": "com.lanchat.lite",
  "build": {
    "beforeDevCommand": "npm run dev:lite",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build:lite",
    "frontendDist": "../dist-lite"
  },
  "app": {
    "windows": [
      {
        "title": "LanChat Lite",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**",
          "$EXE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/desktop-pets/**/*"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
